{
  "description": "Journals across devices: renames, archiving, name collisions, deletes.",
  "scenarios": [
    {
      "name": "a rename reaches the other device",
      "devices": {
        "a": "basic",
        "b": null
      },
      "steps": [
        {
          "sync": "a"
        },
        {
          "sync": "b"
        },
        {
          "device": "a",
          "op": "renameJournal",
          "request": {
            "id": "03aq5qh9copxys3mzz5l8q60f",
            "name": "office"
          },
          "response": {
            "id": "03aq5qh9copxys3mzz5l8q60f",
            "name": "office",
            "archived": false,
            "noteCount": 2
          }
        },
        {
          "sync": "a"
        },
        {
          "sync": "b"
        },
        {
          "device": "b",
          "op": "listJournals",
          "response": {
            "journals": [
              {
                "id": "03aq5qh9copxys3mzz5l8q60f",
                "name": "office",
                "archived": false,
                "noteCount": 2
              },
              {
                "id": "03aqdjryx3t7dd9h7lezzx83o",
                "name": "personal",
                "archived": false,
                "noteCount": 1
              }
            ]
          }
        }
      ]
    },
